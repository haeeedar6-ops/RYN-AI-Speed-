<Window x:Class="RynSpeed.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RYN-AI-Speed v1.0"
        Height="640"
        Width="960"
        FlowDirection="RightToLeft"
        Background="{StaticResource RynBackgroundBrush}"
        Foreground="{StaticResource RynTextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="RYN-AI-Speed v1.0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource RynEmeraldBrush}" />
                <TextBlock x:Name="StatusBannerText" Text="النواة المشفرة SQLCipher + DPAPI جاهزة" FontSize="13" Foreground="{StaticResource RynTextMutedBrush}" />
            </StackPanel>
            <CheckBox x:Name="AutoManagerToggle"
                      DockPanel.Dock="Right"
                      Content="المدير التلقائي الذكي (AI Auto)"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource RynTextPrimaryBrush}"
                      Checked="AutoManagerToggle_Changed"
                      Unchecked="AutoManagerToggle_Changed" />
        </DockPanel>

        <TabControl Grid.Row="1" Background="{StaticResource RynSurfaceBrush}" BorderBrush="#1F2937">
            <TabItem Header="⬇ مدير التنزيلات">
                <Grid Margin="16" Background="{StaticResource RynBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button x:Name="DownloadBtn"
                                DockPanel.Dock="Right"
                                Content="تنزيل سريع"
                                Width="120"
                                Height="36"
                                Margin="8,0,0,0"
                                Background="{StaticResource RynEmeraldBrush}"
                                Foreground="#041C14"
                                FontWeight="Bold"
                                Click="DownloadBtn_Click" />
                        <TextBox x:Name="DownloadUrlBox"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Background="{StaticResource RynSurfaceBrush}"
                                 Foreground="{StaticResource RynTextPrimaryBrush}"
                                 BorderBrush="#374151"
                                 Text="https://" />
                    </DockPanel>
                    <ListBox x:Name="DownloadsLogList"
                             Grid.Row="1"
                             Background="{StaticResource RynSurfaceBrush}"
                             Foreground="{StaticResource RynTextPrimaryBrush}"
                             BorderBrush="#1F2937" />
                </Grid>
            </TabItem>

            <TabItem Header="⚡ فحص الشبكة الحقيقي">
                <Grid Margin="16" Background="{StaticResource RynBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="RunNetTestBtn"
                            Grid.Row="0"
                            Content="تشغيل فحص Ping و Jitter و DNS الحقيقي"
                            Height="40"
                            Margin="0,0,0,12"
                            Background="{StaticResource RynEmeraldBrush}"
                            Foreground="#041C14"
                            FontWeight="Bold"
                            Click="RunNetTestBtn_Click" />
                    <TextBox x:Name="NetworkReportBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12"
                             Background="{StaticResource RynSurfaceBrush}"
                             Foreground="{StaticResource RynTextPrimaryBrush}"
                             BorderBrush="#1F2937"
                             Text="اضغط الزر أعلاه لتشغيل قياسات حقيقية للاتصال وخوادم DNS..." />
                </Grid>
            </TabItem>

            <TabItem Header="🛡 حماية VPN (WireGuard)">
                <StackPanel Margin="16" Background="{StaticResource RynBackgroundBrush}">
                    <TextBlock Text="محرك WireGuard + Kill Switch (WFP)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource RynEmeraldBrush}" Margin="0,0,0,10" />
                    <TextBlock x:Name="VpnStateText" Text="الحالة: غير متصل — أضف ملف إعداد سيرفر WireGuard موثّق للاتصال الفعلي." Foreground="{StaticResource RynTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="الحمايات المفعّلة: منع تسرب DNS (SMHNR) + توجيه IPv6 الكامل (::/0) + تقييم السيرفرات الموزون." Foreground="{StaticResource RynTextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="🤖 مساعد RYN الذكي">
                <Grid Margin="16" Background="{StaticResource RynBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="AiChatList"
                             Grid.Row="0"
                             Margin="0,0,0,10"
                             Background="{StaticResource RynSurfaceBrush}"
                             Foreground="{StaticResource RynTextPrimaryBrush}"
                             BorderBrush="#1F2937" />
                    <DockPanel Grid.Row="1">
                        <Button DockPanel.Dock="Right"
                                Content="إرسال"
                                Width="100"
                                Height="36"
                                Margin="8,0,0,0"
                                Background="{StaticResource RynEmeraldBrush}"
                                Foreground="#041C14"
                                FontWeight="Bold"
                                Click="AiSendBtn_Click" />
                        <TextBox x:Name="AiInputBox"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Background="{StaticResource RynSurfaceBrush}"
                                 Foreground="{StaticResource RynTextPrimaryBrush}"
                                 BorderBrush="#374151" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
