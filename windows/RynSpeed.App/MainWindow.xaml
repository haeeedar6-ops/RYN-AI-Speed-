<Window x:Class="RynSpeed.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RYN-AI-Speed v1.0"
        Icon="ryn.ico"
        Height="640"
        Width="960"
        FlowDirection="RightToLeft"
        Background="{StaticResource RynBackgroundBrush}"
        Foreground="{StaticResource RynTextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#16242A" />
            <Setter Property="Foreground" Value="{StaticResource RynTextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource RynTextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="12,9" Margin="4,2" CornerRadius="8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16242A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#064E3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="RYN-AI-Speed v1.0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource RynEmeraldBrush}" />
                <TextBlock x:Name="StatusBannerText" Text="النواة المشفرة SQLCipher + DPAPI جاهزة" FontSize="13" Foreground="{StaticResource RynTextMutedBrush}" />
            </StackPanel>
            <CheckBox x:Name="AutoManagerToggle"
                      DockPanel.Dock="Right"
                      Content="المدير التلقائي الذكي (AI Auto)"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource RynTextPrimaryBrush}"
                      Checked="AutoManagerToggle_Changed"
                      Unchecked="AutoManagerToggle_Changed" />
        </DockPanel>

        <TabControl Grid.Row="1" Background="{StaticResource RynSurfaceBrush}" BorderBrush="#1F2937">
            <TabItem Header="⬇ مدير التنزيلات">
                <Grid Background="{StaticResource RynBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="10,10,10,6">
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="AddBtn"
                                    DockPanel.Dock="Right"
                                    Content="＋ إضافة"
                                    Width="110"
                                    Height="36"
                                    Margin="8,0,0,0"
                                    Background="{StaticResource RynEmeraldBrush}"
                                    Foreground="#041C14"
                                    FontWeight="Bold"
                                    Click="AddBtn_Click" />
                            <TextBox x:Name="DownloadUrlBox"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     Background="{StaticResource RynSurfaceBrush}"
                                     Foreground="{StaticResource RynTextPrimaryBrush}"
                                     BorderBrush="#374151"
                                     Text="https://"
                                     KeyDown="DownloadUrlBox_KeyDown" />
                        </DockPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource ToolButton}" Content="⏸ إيقاف" Click="PauseBtn_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="▶ استئناف" Click="ResumeBtn_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="⏹ إلغاء" Click="CancelBtn_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="🗑 حذف" Click="RemoveBtn_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="📂 فتح المجلد" Click="OpenFolderBtn_Click" />
                            <TextBlock Text="حد السرعة:" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{StaticResource RynTextMutedBrush}" />
                            <ComboBox x:Name="SpeedLimitCombo" Width="120" SelectedIndex="0">
                                <ComboBoxItem Content="بدون حد" />
                                <ComboBoxItem Content="512 KB/s" />
                                <ComboBoxItem Content="1 MB/s" />
                                <ComboBoxItem Content="5 MB/s" />
                                <ComboBoxItem Content="10 MB/s" />
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>

                    <ListBox x:Name="CategoryList"
                             Grid.Row="1"
                             Grid.Column="0"
                             Margin="10,4,4,4"
                             Background="{StaticResource RynSurfaceBrush}"
                             BorderBrush="#1F2937"
                             SelectedIndex="0">
                        <ListBoxItem Tag="ALL" Content="📁 الكل" />
                        <ListBoxItem Tag="ACTIVE" Content="⬇ قيد التنزيل" />
                        <ListBoxItem Tag="DONE" Content="✅ مكتمل" />
                        <ListBoxItem Tag="STOPPED" Content="⏸ متوقف / فاشل" />
                        <ListBoxItem Tag="VIDEO" Content="🎬 فيديو" />
                        <ListBoxItem Tag="AUDIO" Content="🎵 صوت" />
                        <ListBoxItem Tag="IMAGES" Content="🖼 صور" />
                        <ListBoxItem Tag="ARCHIVES" Content="🗜 أرشيف" />
                        <ListBoxItem Tag="SOFTWARE" Content="💿 برامج" />
                        <ListBoxItem Tag="DOCUMENTS" Content="📄 مستندات" />
                        <ListBoxItem Tag="OTHER" Content="📦 أخرى" />
                    </ListBox>

                    <DataGrid x:Name="DownloadsGrid"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="4,4,10,4"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1F2937"
                              BorderBrush="#1F2937"
                              Background="{StaticResource RynSurfaceBrush}"
                              RowBackground="{StaticResource RynSurfaceBrush}"
                              AlternatingRowBackground="#0F171B"
                              Foreground="{StaticResource RynTextPrimaryBrush}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#16242A" />
                                <Setter Property="Foreground" Value="{StaticResource RynTextPrimaryBrush}" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#064E3B" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="الحجم" Binding="{Binding SizeText, Mode=OneWay}" Width="90" />
                            <DataGridTemplateColumn Header="التقدم" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Height="16"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         Foreground="{StaticResource RynEmeraldBrush}"
                                                         Background="#1F2937"
                                                         BorderThickness="0" />
                                            <TextBlock Text="{Binding ProgressText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="White" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="السرعة" Binding="{Binding SpeedText, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding EtaText, Mode=OneWay}" Width="80" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText, Mode=OneWay}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Background="#0F171B"
                            Padding="12,6">
                        <TextBlock x:Name="DownloadsStatusText"
                                   Foreground="{StaticResource RynTextMutedBrush}"
                                   Text="لا توجد تنزيلات بعد. الصق رابطاً واضغط إضافة." />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="⚡ فحص الشبكة الحقيقي">
                <Grid Margin="16" Background="{StaticResource RynBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="RunNetTestBtn"
                            Grid.Row="0"
                            Content="تشغيل فحص Ping و Jitter و DNS الحقيقي"
                            Height="40"
                            Margin="0,0,0,12"
                            Background="{StaticResource RynEmeraldBrush}"
                            Foreground="#041C14"
                            FontWeight="Bold"
                            Click="RunNetTestBtn_Click" />
                    <TextBox x:Name="NetworkReportBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12"
                             Background="{StaticResource RynSurfaceBrush}"
                             Foreground="{StaticResource RynTextPrimaryBrush}"
                             BorderBrush="#1F2937"
                             Text="اضغط الزر أعلاه لتشغيل قياسات حقيقية للاتصال وخوادم DNS..." />
                </Grid>
            </TabItem>

            <TabItem Header="🛡 حماية VPN (WireGuard)">
                <StackPanel Margin="16" Background="{StaticResource RynBackgroundBrush}">
                    <TextBlock Text="محرك WireGuard + Kill Switch (WFP)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource RynEmeraldBrush}" Margin="0,0,0,10" />
                    <TextBlock x:Name="VpnStateText" Text="الحالة: غير متصل — أضف ملف إعداد سيرفر WireGuard موثّق للاتصال الفعلي." Foreground="{StaticResource RynTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="الحمايات المفعّلة: منع تسرب DNS (SMHNR) + توجيه IPv6 الكامل (::/0) + تقييم السيرفرات الموزون." Foreground="{StaticResource RynTextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="🤖 مساعد RYN الذكي">
                <Grid Margin="16" Background="{StaticResource RynBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="AiChatList"
                             Grid.Row="0"
                             Margin="0,0,0,10"
                             Background="{StaticResource RynSurfaceBrush}"
                             Foreground="{StaticResource RynTextPrimaryBrush}"
                             BorderBrush="#1F2937" />
                    <DockPanel Grid.Row="1">
                        <Button DockPanel.Dock="Right"
                                Content="إرسال"
                                Width="100"
                                Height="36"
                                Margin="8,0,0,0"
                                Background="{StaticResource RynEmeraldBrush}"
                                Foreground="#041C14"
                                FontWeight="Bold"
                                Click="AiSendBtn_Click" />
                        <TextBox x:Name="AiInputBox"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Background="{StaticResource RynSurfaceBrush}"
                                 Foreground="{StaticResource RynTextPrimaryBrush}"
                                 BorderBrush="#374151" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
