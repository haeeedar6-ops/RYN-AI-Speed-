<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>RynSpeed.App</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RynSpeed.Core\RynSpeed.Core.csproj" />
    <ProjectReference Include="..\RynSpeed.Security\RynSpeed.Security.csproj" />
    <ProjectReference Include="..\RynSpeed.Database\RynSpeed.Database.csproj" />
    <ProjectReference Include="..\RynSpeed.Downloads\RynSpeed.Downloads.csproj" />
    <ProjectReference Include="..\RynSpeed.Browser\RynSpeed.Browser.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
