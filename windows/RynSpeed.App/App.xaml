<Application x:Class="RynSpeed.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="RynBackgroundBrush" Color="#0B1114" />
        <SolidColorBrush x:Key="RynSurfaceBrush" Color="#111A1E" />
        <SolidColorBrush x:Key="RynEmeraldBrush" Color="#10B981" />
        <SolidColorBrush x:Key="RynTextPrimaryBrush" Color="#ECFDF5" />
        <SolidColorBrush x:Key="RynTextMutedBrush" Color="#9CA3AF" />
    </Application.Resources>
</Application>
